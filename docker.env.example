# Persistent Docker data is mounted at /data.
# Put your RVC files in ./docker-data/models on the host.

VOICE_NAME=en_US-nekoai-medium
RVC_MODEL=models/Neeko.pth
RVC_INDEX=models/Neeko.index

# Compute backend. docker-compose.cpu.yml forces cpu and
# docker-compose.gpu.yml can use gpu/auto when NVIDIA is available.
COMPUTE=auto

# Base Piper voice. Short aliases "alba" and "amy" also work.
# Default/recommended starting point:
BASE_PIPER_VOICE=en_GB-alba-medium
# Example alternative:
# BASE_PIPER_VOICE=en_US-amy-medium

# For a custom base Piper model in ./docker-data/models, uncomment both:
# BASE_PIPER_MODEL=models/custom-base.onnx
# BASE_PIPER_CONFIG=models/custom-base.onnx.json

PITCH=12
INDEX_RATE=0.75
PROTECT=0.33
F0_METHOD=rmvpe

PROMPT_LIMIT=120
# Leave PROMPT_FILE unset to use data/piper_training_prompts.txt from the image.
# PROMPT_FILE=prompts/my-prompts.txt

BATCH_SIZE=8
MAX_EPOCHS=1000
CHECKPOINT_EVERY=5
NUM_WORKERS=2
ESPEAK_VOICE=en-GB-x-rp

# Run a one-sentence Piper + RVC test before the full dataset/training job.
RUN_PREFLIGHT=1

# Reuse an existing persistent dataset instead of generating it again.
SKIP_DATASET=0

# 0 = automatically resume from the newest last.ckpt when one exists.
# 1 = always start a fresh warm-start fine-tune.
NO_RESUME=0
